{
  "name": "dsh-react-surface-build",
  "version": "0.0.1",
  "private": true,
  "description": "Bun build adapter for DSH React Surface packages",
  "type": "module",
  "bin": {
    "dsh-react-surface-build": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./scaffold": "./src/scaffold.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src/cli.ts",
    "src/index.ts",
    "src/scaffold.ts"
  ],
  "dependencies": {
    "postcss": "^8.5.6",
    "postcss-url": "^10.1.3"
  },
  "devDependencies": {
    "@types/postcss-url": "^10.0.4"
  }
}
