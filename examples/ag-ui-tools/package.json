{
  "name": "dsh-react-surface-example-ag-ui-tools",
  "version": "0.0.1",
  "private": true,
  "description": "Optional dsh-ag-ui Tool integration example for React Surface",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "reactSurface": {
      "id": "example.ag-ui-tools"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-react-surface"
      ],
      "external": [
        "dsh-react-surface/client"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "dsh-react-surface": "0.0.1",
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "dsh-react-surface": "workspace:*",
    "dsh-react-surface-build": "workspace:*"
  }
}
